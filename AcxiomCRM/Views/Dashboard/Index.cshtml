@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">AcxiomCRM Dashboard</h2>
            <p class="text-muted mb-0">Overview of CRM metrics and operational pipeline</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-primary btn-sm">+ Customer</a>
            <a asp-controller="Opportunities" asp-action="Create" class="btn btn-outline-success btn-sm">+ Opportunity</a>
            <a asp-controller="FollowUps" asp-action="Create" class="btn btn-outline-info btn-sm">+ Follow-Up</a>
        </div>
    </div>

    <!-- 8 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Customers -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Total Customers</div>
                    <div class="fs-3 fw-bold text-dark mt-1" id="kpi-total-customers">@Model.TotalCustomers</div>
                    <div class="small text-muted mt-1"><a asp-controller="Customers" asp-action="Index" class="text-decoration-none">View directory &rarr;</a></div>
                </div>
            </div>
        </div>

        <!-- 2. Active Customers -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Active Customers</div>
                    <div class="fs-3 fw-bold text-success mt-1" id="kpi-active-customers">@Model.ActiveCustomers</div>
                    <div class="small text-muted mt-1">Status: Active</div>
                </div>
            </div>
        </div>

        <!-- 3. Total Leads -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Total Leads</div>
                    <div class="fs-3 fw-bold text-info mt-1" id="kpi-total-leads">@Model.TotalLeads</div>
                    <div class="small text-muted mt-1">Lead capture pool</div>
                </div>
            </div>
        </div>

        <!-- 4. Open Leads -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Open Leads</div>
                    <div class="fs-3 fw-bold text-warning mt-1" id="kpi-open-leads">@Model.OpenLeads</div>
                    <div class="small text-muted mt-1">Unconverted leads</div>
                </div>
            </div>
        </div>

        <!-- 5. Total Opportunities -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Total Opportunities</div>
                    <div class="fs-3 fw-bold text-dark mt-1" id="kpi-total-opportunities">@Model.TotalOpportunities</div>
                    <div class="small text-muted mt-1"><a asp-controller="Opportunities" asp-action="Index" class="text-decoration-none">View all deals &rarr;</a></div>
                </div>
            </div>
        </div>

        <!-- 6. Open Pipeline Value -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Open Pipeline Value</div>
                    <div class="fs-3 fw-bold text-success mt-1" id="kpi-open-pipeline-value">$@Model.OpenPipelineValue.ToString("N2")</div>
                    <div class="small text-muted mt-1">Open deals sum</div>
                </div>
            </div>
        </div>

        <!-- 7. Won Opportunities -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Won Opportunities</div>
                    <div class="fs-3 fw-bold text-success mt-1" id="kpi-won-opportunities">@Model.WonOpportunities</div>
                    <div class="small text-muted mt-1">Closed won deals</div>
                </div>
            </div>
        </div>

        <!-- 8. Pending Follow-Ups -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Pending Follow-Ups</div>
                    <div class="fs-3 fw-bold text-danger mt-1" id="kpi-pending-followups">@Model.PendingFollowUps</div>
                    <div class="small text-muted mt-1"><a asp-controller="FollowUps" asp-action="Index" class="text-decoration-none">Pending actions &rarr;</a></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Charts Section -->
    <div class="row g-4">
        <!-- Chart 1: Opportunity Pipeline / Stage Distribution -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold">Pipeline Stage Distribution</h6>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div style="position: relative; height: 260px;">
                        <canvas id="stageDistChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Opportunity Value by Stage -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold">Opportunity Value by Stage ($)</h6>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div style="position: relative; height: 260px;">
                        <canvas id="stageValueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 3: Follow-Up / Activity Trend -->
        <div class="col-lg-4 col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold">Follow-Up Status & Activity</h6>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div style="position: relative; height: 260px;">
                        <canvas id="activityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chart 1: Stage Distribution (Doughnut)
            var stageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels));
            var stageCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageCounts));

            var ctx1 = document.getElementById('stageDistChart').getContext('2d');
            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: stageLabels,
                    datasets: [{
                        data: stageCounts,
                        backgroundColor: [
                            '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#198754', '#e74a3b'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12 }
                        }
                    }
                }
            });

            // Chart 2: Value by Stage (Bar)
            var valueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StageValueLabels));
            var stageValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StageValues));

            var ctx2 = document.getElementById('stageValueChart').getContext('2d');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: valueLabels,
                    datasets: [{
                        label: 'Value ($)',
                        data: stageValues,
                        backgroundColor: '#36b9cc'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Chart 3: Follow-Up / Activity (Bar)
            var actLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityLabels));
            var actCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityCounts));

            var ctx3 = document.getElementById('activityChart').getContext('2d');
            new Chart(ctx3, {
                type: 'bar',
                data: {
                    labels: actLabels,
                    datasets: [{
                        label: 'Follow-Ups',
                        data: actCounts,
                        backgroundColor: ['#f6c23e', '#198754']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}
